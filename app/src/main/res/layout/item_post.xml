
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#000000">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">


        <ImageView
            android:id="@+id/ivPostAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/profile_circle_background"
            android:scaleType="centerCrop"
            android:padding="0dp"
            android:clipToOutline="true"
            android:contentDescription="Author profile photo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="9dp">

            <TextView
                android:id="@+id/tvPostUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPostSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#DDDDDD"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnPostOptions"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:contentDescription="Post options" />

    </LinearLayout>


    <ImageView
        android:id="@+id/ivPostImage"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="#292929"
        android:scaleType="centerCrop"
        android:contentDescription="Post image" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btnLike"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="1dp"
            android:src="@drawable/ic_heart_outline"
            android:scaleType="fitCenter"
            android:contentDescription="Like post"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnComment"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="18dp"
            android:padding="1dp"
            android:src="@drawable/ic_comment_outline"
            android:scaleType="fitCenter"
            android:contentDescription="View comments"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="18dp"
            android:padding="1dp"
            android:src="@drawable/ic_share_outline"
            android:scaleType="fitCenter"
            android:contentDescription="Share post"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnBookmark"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="1dp"
            android:src="@drawable/ic_bookmark_outline"
            android:scaleType="fitCenter"
            android:contentDescription="Save post"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvPostCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="3dp"
        android:paddingBottom="5dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />


    <TextView
        android:id="@+id/tvViewAllComments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingBottom="5dp"
        android:text="View all comments"
        android:textColor="#999999"
        android:textSize="12sp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />


    <TextView
        android:id="@+id/tvPostTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="13dp"
        android:paddingBottom="14dp"
        android:textColor="#999999"
        android:textSize="12sp" />

</LinearLayout>

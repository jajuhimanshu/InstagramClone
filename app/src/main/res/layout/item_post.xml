<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Author information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvPostAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/profile_circle_background"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="9dp">

            <TextView
                android:id="@+id/tvPostUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPostSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#DDDDDD"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnPostOptions"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

    </LinearLayout>

    <!-- Post image -->
    <ImageView
        android:id="@+id/ivPostImage"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="#292929"
        android:scaleType="centerCrop"
        android:contentDescription="Post image" />

    <!-- Like, comment, share and bookmark actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnLike"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:contentDescription="Like post"
            android:text="♡"
            android:textColor="#FFFFFF"
            android:textSize="29sp" />

        <TextView
            android:id="@+id/btnComment"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="View comments"
            android:text="○"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Share post"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnBookmark"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:contentDescription="Save post"
            android:text="♧"
            android:textColor="#FFFFFF"
            android:textSize="27sp" />

    </LinearLayout>

    <!-- Like count -->
    <TextView
        android:id="@+id/tvLikeCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Caption -->
    <TextView
        android:id="@+id/tvPostCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Comment count -->
    <TextView
        android:id="@+id/tvCommentCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingBottom="5dp"
        android:textColor="#999999"
        android:textSize="12sp" />

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tvPostTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="13dp"
        android:paddingBottom="14dp"
        android:textColor="#999999"
        android:textSize="12sp" />

</LinearLayout>
